# Public production origin used for canonical URLs, Open Graph URLs and sitemap.xml.
# Set this to the real domain before running `npm run build` (no trailing slash).
SITE_URL=https://your-domain.com

# Optional: disable the debounced static-page refresh after admin edits.
# SEO_AUTO_REFRESH=false

# Optional: override the build output / generated-state directories.
# SEO_DIST_DIR=dist
# SEO_STATE_DIR=.seo
